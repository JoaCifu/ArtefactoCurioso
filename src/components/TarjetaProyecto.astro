---
import { Image } from 'astro:assets';

const { proyecto } = Astro.props;
const { id, data } = proyecto;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<article
  class="break-inside-avoid mb-4"
  data-usos={data.usos.join('|')}
  data-materiales={data.materiales.join('|')}
>
  <a
    href={`${base}/proyectos/${id}/`}
    class="group relative block overflow-hidden rounded-sm bg-tinta/5"
  >
    <Image
      src={data.fotos[0]}
      alt={data.titulo}
      width={800}
      class="w-full h-auto transition-transform duration-500 group-hover:scale-105"
    />
    <div
      class="absolute inset-x-0 bottom-0 p-3 text-white bg-linear-to-t from-black/70 to-transparent
             md:opacity-0 md:group-hover:opacity-100 transition-opacity duration-300"
    >
      <h2 class="font-bold leading-tight">{data.titulo}</h2>
      <p class="text-xs opacity-90">
        {[...data.usos, ...data.materiales].join(' · ')}
      </p>
    </div>
  </a>
</article>