---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { obtenerProyectos } from '../../data/proyectos';

export async function getStaticPaths() {
  const proyectos = await obtenerProyectos();
  return proyectos.map((entry, i) => ({
    params: { id: entry.id },
    props: {
      entry,
      anterior: proyectos[i - 1] ?? null,
      siguiente: proyectos[i + 1] ?? null,
    },
  }));
}

const { entry, anterior, siguiente } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

// Tres tamaños por foto: miniatura, vista principal y ampliación
const fotos = await Promise.all(
  data.fotos.map(async (f) => ({
    mini: (await getImage({ src: f, width: 240, height: 240, fit: 'cover' })).src,
    media: (await getImage({ src: f, width: 1200 })).src,
    grande: (await getImage({ src: f, width: 2000 })).src,
  })),
);
const varias = fotos.length > 1;
---
<Base titulo={`${data.titulo} · Taller Artefacto Curioso`} descripcion={data.resumen}>
  <a href={`${base}/`} class="text-sm underline hover:text-acento">← Todos los proyectos</a>

  <div class="mt-6 grid gap-8 lg:grid-cols-[3fr_2fr]">
    <!-- Galería -->
    <section aria-label="Fotos del proyecto">
      <button
        type="button"
        id="abrir"
        class="block w-full aspect-4/3 bg-tinta/5 rounded-sm overflow-hidden cursor-zoom-in"
        aria-label="Ampliar foto"
      >
        <img
          id="principal"
          src={fotos[0].media}
          alt={data.titulo}
          class="w-full h-full object-contain"
        />
      </button>

      {varias && (
        <div class="mt-3 grid grid-cols-5 gap-2">
          {fotos.map((f, i) => (
            <button
              type="button"
              data-indice={i}
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={`Ver foto ${i + 1}`}
              class="aspect-square overflow-hidden rounded-sm opacity-70 hover:opacity-100
                     aria-[current=true]:opacity-100 aria-[current=true]:ring-2 aria-[current=true]:ring-acento"
            >
              <img src={f.mini} alt="" loading="lazy" class="w-full h-full object-cover" />
            </button>
          ))}
        </div>
      )}
    </section>

    <!-- Texto -->
    <section>
      <h1 class="text-3xl font-bold leading-tight">{data.titulo}</h1>
      <p class="mt-1 text-sm opacity-70">{data.anio}</p>

      <ul class="mt-4 flex flex-wrap gap-2">
        {data.usos.map((u) => (
          <li class="rounded-full border border-acento bg-acento px-3 py-1 text-sm text-white first-letter:uppercase">
            {u}
          </li>
        ))}
        {data.materiales.map((m) => (
          <li class="rounded-full border border-tinta/40 px-3 py-1 text-sm first-letter:uppercase">
            {m}
          </li>
        ))}
      </ul>

      <div class="mt-6 leading-relaxed [&_p]:mb-4">
        <Content />
      </div>
    </section>
  </div>

  <!-- Anterior / siguiente -->
  <nav class="mt-12 flex justify-between gap-4 border-t border-tinta/15 pt-6 text-sm">
    {anterior ? (
      <a href={`${base}/proyectos/${anterior.id}/`} class="hover:text-acento">
        ← {anterior.data.titulo}
      </a>
    ) : <span />}
    {siguiente ? (
      <a href={`${base}/proyectos/${siguiente.id}/`} class="text-right hover:text-acento">
        {siguiente.data.titulo} →
      </a>
    ) : <span />}
  </nav>

  <!-- Ampliación -->
  <dialog id="ampliacion" class="m-0 h-screen w-screen max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/90">
    <div id="fondo" class="flex h-full w-full items-center justify-center">
      <img id="grande" src="" alt={data.titulo} class="max-h-[90vh] max-w-[95vw] object-contain" />
    </div>
    <button type="button" id="cerrar" aria-label="Cerrar" class="absolute right-4 top-4 text-3xl text-white">✕</button>
    {varias && (
      <>
        <button type="button" id="prev" aria-label="Foto anterior" class="absolute left-3 top-1/2 -translate-y-1/2 p-3 text-4xl text-white">‹</button>
        <button type="button" id="next" aria-label="Foto siguiente" class="absolute right-3 top-1/2 -translate-y-1/2 p-3 text-4xl text-white">›</button>
      </>
    )}
  </dialog>

  <script type="application/json" id="datos-fotos" set:html={JSON.stringify(fotos)} />
</Base>

<script>
  type Foto = { mini: string; media: string; grande: string };
  const fotos: Foto[] = JSON.parse(document.getElementById('datos-fotos')!.textContent!);

  const principal = document.getElementById('principal') as HTMLImageElement;
  const grande = document.getElementById('grande') as HTMLImageElement;
  const dialogo = document.getElementById('ampliacion') as HTMLDialogElement;
  const miniaturas = document.querySelectorAll<HTMLButtonElement>('[data-indice]');
  let actual = 0;

  function mostrar(i: number) {
    actual = (i + fotos.length) % fotos.length;
    principal.src = fotos[actual].media;
    grande.src = fotos[actual].grande;
    miniaturas.forEach((m, k) => m.setAttribute('aria-current', String(k === actual)));
  }

  miniaturas.forEach((m) =>
    m.addEventListener('click', () => mostrar(Number(m.dataset.indice))),
  );

  document.getElementById('abrir')!.addEventListener('click', () => {
    grande.src = fotos[actual].grande;
    dialogo.showModal();
  });
  document.getElementById('cerrar')!.addEventListener('click', () => dialogo.close());
  document.getElementById('fondo')!.addEventListener('click', (e) => {
    if (e.target === e.currentTarget) dialogo.close();
  });
  document.getElementById('prev')?.addEventListener('click', () => mostrar(actual - 1));
  document.getElementById('next')?.addEventListener('click', () => mostrar(actual + 1));

  // Teclado: flechas (Esc cierra solo)
  document.addEventListener('keydown', (e) => {
    if (fotos.length < 2) return;
    if (e.key === 'ArrowLeft') mostrar(actual - 1);
    if (e.key === 'ArrowRight') mostrar(actual + 1);
  });

  // Deslizar con el dedo en la ampliación
  let inicioX = 0;
  dialogo.addEventListener('touchstart', (e) => (inicioX = e.touches[0].clientX));
  dialogo.addEventListener('touchend', (e) => {
    const dx = e.changedTouches[0].clientX - inicioX;
    if (Math.abs(dx) > 50 && fotos.length > 1) mostrar(actual + (dx < 0 ? 1 : -1));
  });
</script>