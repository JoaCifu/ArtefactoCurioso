---
import { obtenerProyectos } from '../data/proyectos';
import Base from '../layouts/Base.astro';
import TarjetaProyecto from '../components/TarjetaProyecto.astro';
import { USOS, MATERIALES } from '../data/atributos';

const proyectos = await obtenerProyectos();
// Solo se ofrecen filtros que tengan al menos un proyecto
const usosPresentes = USOS.filter((u) => proyectos.some((p) => p.data.usos.includes(u)));
const materialesPresentes = MATERIALES.filter((m) =>
  proyectos.some((p) => p.data.materiales.includes(m)),
);

const grupos = [
  { clave: 'usos', titulo: 'Categoría', valores: usosPresentes },
  { clave: 'materiales', titulo: 'Material', valores: materialesPresentes },
];
---
<Base>
  <section class="mb-8 max-w-2xl">
    <h1 class="text-3xl font-bold mb-2">Proyectos</h1>
    <p>
      Utilería, escenografía, muñecos y corpóreos de fabricación nacional, en nuestro taller propio.
      Filtra por categoria o material para explorar nuestros trabajos.
    </p>
  </section>

  <section class="mb-8 space-y-4" aria-label="Filtros">
    {grupos.map((g) => (
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-sm font-bold mr-2 w-20">{g.titulo}</span>
        {g.valores.map((v) => (
          <button
            type="button"
            data-filtro={g.clave}
            data-valor={v}
            aria-pressed="false"
            class="first-letter:uppercase rounded-full border border-tinta/40 px-3 py-1 text-sm
                   hover:border-acento transition-colors
                   aria-pressed:bg-acento aria-pressed:border-acento aria-pressed:text-white"
          >
            {v}
          </button>
        ))}
      </div>
    ))}
    <button id="limpiar" type="button" hidden class="text-sm underline hover:text-acento">
      Limpiar filtros
    </button>
  </section>

  <div class="columns-1 sm:columns-2 lg:columns-3 gap-4">
    {proyectos.map((p) => <TarjetaProyecto proyecto={p} />)}
  </div>

  <p id="vacio" hidden class="py-12 text-center">
    Ningún proyecto coincide con esos filtros.
  </p>
</Base>

<script>
  const seleccion = {
    usos: new Set<string>(),
    materiales: new Set<string>(),
  };
  type Grupo = keyof typeof seleccion;

  const botones = document.querySelectorAll<HTMLButtonElement>('[data-filtro]');
  const tarjetas = document.querySelectorAll<HTMLElement>('article[data-usos]');
  const limpiar = document.getElementById('limpiar') as HTMLButtonElement;
  const vacio = document.getElementById('vacio') as HTMLElement;

  function aplicar() {
    let visibles = 0;
    tarjetas.forEach((t) => {
      const usos = (t.dataset.usos ?? '').split('|');
      const mats = (t.dataset.materiales ?? '').split('|');
      // Dentro de un grupo: "o". Entre grupos: "y".
      const okUsos = seleccion.usos.size === 0 || usos.some((u) => seleccion.usos.has(u));
      const okMats =
        seleccion.materiales.size === 0 || mats.some((m) => seleccion.materiales.has(m));
      t.hidden = !(okUsos && okMats);
      if (!t.hidden) visibles++;
    });
    vacio.hidden = visibles !== 0;
    limpiar.hidden = seleccion.usos.size + seleccion.materiales.size === 0;
  }

  botones.forEach((b) => {
    b.addEventListener('click', () => {
      const grupo = b.dataset.filtro as Grupo;
      const valor = b.dataset.valor as string;
      if (seleccion[grupo].has(valor)) {
        seleccion[grupo].delete(valor);
        b.setAttribute('aria-pressed', 'false');
      } else {
        seleccion[grupo].add(valor);
        b.setAttribute('aria-pressed', 'true');
      }
      aplicar();
    });
  });

  limpiar.addEventListener('click', () => {
    seleccion.usos.clear();
    seleccion.materiales.clear();
    botones.forEach((b) => b.setAttribute('aria-pressed', 'false'));
    aplicar();
  });
</script>